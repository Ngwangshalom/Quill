--- Every value Quill can store: text, a number, and another name.

name = "Amina"
greeting = "Hello"
year = 2026
price = 0.10
copy = greeting
quoted = "She said \"hi\"\tand left."

say name
say greeting
say year
say price
say copy
say quoted

-- A check passes when both sides are the same value.
check name == "Amina"
check greeting == "Hello"
check year == 2026
check price == 0.10
check copy == greeting
check quoted == "She said \"hi\"\tand left."

--- example: name == "Amina"
--- example: greeting == "Hello"
--- example: year == 2026
--- example: price == 0.10
